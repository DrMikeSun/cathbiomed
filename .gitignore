# ============================================================
# CathBiomed .gitignore
# ============================================================
# 分类：
#   1. Python 通用
#   2. 测试 / 覆盖率 / Lint / 类型检查
#   3. Jupyter
#   4. medlitflow 运行数据（全部为运行时产物）
#   5. 用户私有配置（含 API Key，禁止提交）
#   6. 参考数据（JCR 表等，用户私有）
#   7. 临时文件与日志
#   8. IDE / 编辑器
#   9. 操作系统
# ============================================================

# ---------- 1. Python 通用 ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example

# ---------- 2. 测试 / 覆盖率 / Lint / 类型检查 ----------
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pytype/

# ---------- 3. Jupyter ----------
.ipynb_checkpoints/
*.ipynb_checkpoints/

# ---------- 4. medlitflow 运行数据 ----------
# 主输出目录：run / library / archive / raw 全为运行产物
data/

# 批量队列汇总（output_root 下的运行产物）
batch_summary_*.json

# abandon 日志（运行期生成）
abandon_log.jsonl

# UI 运行临时配置（默认在系统 temp；若用户改路径则落在项目内）
medlitflow_ui/

# 数据文件兜底（data/ 已整体排除，此处防临时/测试场景泄漏）
*.parquet
*.parquet.tmp
*.jsonl

# ---------- 5. 用户私有配置（含 API Key，禁止提交） ----------
# 用户在「设置」页保存后生成；含 ncbi_api_key / s2_api_key 等敏感信息
config/user.yaml
config/user.yaml.*
# 允许：用户提供模板（可选）
!config/user.yaml.example

# ---------- 6. 参考数据（JCR 表等） ----------
# 用户自备的 JCR 表通常受订阅协议约束，不应公开
reference/JCR IF *.xlsx
reference/JCR IF *.xls
reference/JCR IF *.csv
# 例外：程序包附带的默认 JCR 表（自制/已授权公开分发）
!reference/JCR IF *.default.xlsx
# 允许：reference 目录的说明文件
!reference/README*
!reference/.gitkeep

# ---------- 7. 临时文件与日志 ----------
*.tmp
*.temp
*.bak
*.log
logs/
*.pid
*.seed
*.pid.lock
*.zip
docs/

# ---------- 8. IDE / 编辑器 ----------
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ---------- 9. 操作系统 ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk